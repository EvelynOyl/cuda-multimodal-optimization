# ═══════════════════════════════════════════════════════════════════════════
# .dockerignore — 缩小 Docker 构建上下文，加速构建
# ═══════════════════════════════════════════════════════════════════════════
# 构建时只有 COPY . /app/ 真正需要的文件会进入镜像。
# 以下内容被排除，不会发送到 Docker daemon。

# ── Python 缓存 ────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.eggs/

# ── 虚拟环境（本地 Mac .venv 不适用于 Linux 镜像）──────────────────────────
.venv/
.venv*/
venv/
env/
*venv/

# ── 模型文件（体积巨大，运行时通过 -v 挂载）────────────────────────────────
models/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx

# ── 模型压缩包 ─────────────────────────────────────────────────────────────
*.tar.gz
*.tar
*.tar.xz
*.zip
*.7z

# ── 运行时输出（不应打包进镜像）────────────────────────────────────────────
outputs/
logs/
*.log
bench_results.json
resume_metrics.txt

# ── 测试缓存 ───────────────────────────────────────────────────────────────
.pytest_cache/
.pytest_cache/**
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── 版本控制 ───────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.gitmodules

# ── macOS 特有文件 ─────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.documentrevision

# ── IDE / 编辑器 ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.vscode/
.fleet/

# ── 编译产物（将在镜像内重新编译）──────────────────────────────────────────
*.so
*.o
*.obj
*.a
*.la
*.lo
*.dll
*.dylib
build/
dist/
csrc/build/

# ── 文档（非运行时需要）─────────────────────────────────────────────────────
*.md
!README.md
docs/
*.rst

# ── CI / 工具配置 ──────────────────────────────────────────────────────────
.github/
.gitlab-ci.yml
Jenkinsfile
.pre-commit-config.yaml
.mypy.ini
.editorconfig
.dockerignore
Dockerfile*

# ── 环境 / 密钥（绝对不能进镜像）───────────────────────────────────────────
.env
.env.*
*.key
*.pem
secrets/
credentials/

# ── macOS MLX 后端文件（Linux 不需要）──────────────────────────────────────
**/*_mlx.py

# ── Jupyter notebook ───────────────────────────────────────────────────────
*.ipynb
.ipynb_checkpoints/

# ── 杂项 ───────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
.cache/
